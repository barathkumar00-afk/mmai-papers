# ===========================================================================
# MedExplain AI backend configuration
#
# Copy to `.env` and edit:      cp .env.example .env
# The backend also reads real environment variables, which take precedence.
# ===========================================================================

# --- server ----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Browser origins allowed to call the API. Comma-separated.
# Add your frontend's dev server origin (Vite default is 5173; this project
# pins 3000 -- see vite.config.ts).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false

# ===========================================================================
# MOCK MODE
#
# true  -> no Ollama call is ever made. Every response is explicitly labelled
#          simulated, and no medical content is invented.
# false -> the backend calls your local Ollama and reports per-model
#          availability truthfully. Unavailable models degrade to null fields
#          with a stated reason, never to fabricated content.
#
# The API never fails to start because a model is missing.
# ===========================================================================
MOCK_MODE=true

# ===========================================================================
# Ollama (local, never cloud)
# ===========================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
# Leave empty to disable real image analysis. With a value, set MOCK_MODE=false
# and `ollama pull` a vision-capable model (e.g. llama3.2-vision, llava).
OLLAMA_VISION_MODEL=
# Leave empty to fall back to the lexical hashing encoder. For semantic
# retrieval set e.g. nomic-embed-text and REBUILD the index afterwards
# (changing the encoder changes the vector dimension -- see README).
OLLAMA_EMBEDDING_MODEL=
OLLAMA_TIMEOUT_SECONDS=120

# ===========================================================================
# Embeddings / retrieval
# ===========================================================================
# ollama | sentence-transformers | hashing
# "hashing" is a deterministic lexical encoder: real FAISS search, no model
# download, ranks by token overlap. Always available.
EMBEDDING_PROVIDER=ollama
FAISS_INDEX_TYPE=Flat
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# ===========================================================================
# Paths (relative paths resolve against the backend/ directory)
# ===========================================================================
FAISS_INDEX_PATH=data/indexes/medical.index
FAISS_METADATA_PATH=data/indexes/metadata.json
KNOWLEDGE_DIR=data/knowledge
TEMP_DIR=data/tmp

# ===========================================================================
# Uploads
# ===========================================================================
MAX_UPLOAD_SIZE_MB=20
# Comma-separated extension allow-list. Content is also sniffed by magic bytes;
# an extension alone never authorises a file.
ALLOWED_IMAGE_EXTENSIONS=.dcm,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.flac,.ogg,.webm,.aac
